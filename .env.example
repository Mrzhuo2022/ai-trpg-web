# ── 服务监听 ──────────────────────────────────────────────
# 服务端口（默认 3157；被占用时会自动向后递增尝试）
PORT=3157
# 监听地址。默认 127.0.0.1 仅本机可访问；对外部署时改为 0.0.0.0
HOST=127.0.0.1

# ── LLM 凭据（服务端配置，优先于客户端提交的设置）──────────
# 设置后前端无需再填写 API Key，且服务端配置优先生效
LLM_API_KEY=
# OpenAI 兼容接口地址，如 https://api.openai.com/v1
LLM_BASE_URL=
# 默认模型名，如 gpt-4o-mini
LLM_MODEL=

# ── 安全 ─────────────────────────────────────────────────
# 设为 1 允许 baseUrl 指向内网/回环地址（默认禁止，防 SSRF）
ALLOW_PRIVATE_BASE_URL=
# 诊断接口令牌：设置后 /api/diagnostics/recent 需携带 X-Admin-Token 请求头；
# 未设置时诊断接口仅限本机（127.0.0.1）访问
ADMIN_TOKEN=
# 每 IP 每分钟对 /api/game/* 与 /api/models 的请求上限（默认 30）
RATE_LIMIT_PER_MINUTE=30

# ── 会话与生成参数（一般无需修改）──────────────────────────
# 会话过期时间，毫秒（默认 6 小时，最低 5 分钟）
SESSION_TTL_MS=
# 内存中最多保留的会话数（默认 200）
MAX_SESSIONS=
# 单会话最多保留的消息条数，超出自动摘要裁剪（默认 42）
MAX_SESSION_MESSAGES=
# 单次生成的最大 token 数（默认 1000）
DEFAULT_MAX_TOKENS=
# 每局初始运气点数（默认 3）
INITIAL_LUCK_POINTS=
