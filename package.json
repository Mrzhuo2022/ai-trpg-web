{
  "name": "ai-trpg-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:web": "vite",
    "dev:all": "concurrently -n api,web -c yellow,cyan \"npm run dev\" \"npm run dev:web\"",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "test": "node --experimental-strip-types --test test/*.test.js test/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^10.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
